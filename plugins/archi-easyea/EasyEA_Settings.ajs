/**
 * EasyEA Settings Configuration for Archi (jArchi)
 * Supports:
 * 1) Identity Provider SSO (Keycloak / OIDC Browser Loopback Flow)
 * 2) Local Username & Password Authentication
 */

(function() {
    if (typeof console !== "undefined") {
        console.show();
        console.clear();
        console.log("== EasyEA Settings ==");
    }

    var System = Java.type("java.lang.System");
    var File = Java.type("java.io.File");
    var FileWriter = Java.type("java.io.FileWriter");
    var Scanner = Java.type("java.util.Scanner");
    var URI = Java.type("java.net.URI");
    var HttpClient = Java.type("java.net.http.HttpClient");
    var HttpRequest = Java.type("java.net.http.HttpRequest");
    var HttpResponse = Java.type("java.net.http.HttpResponse");
    var ServerSocket = Java.type("java.net.ServerSocket");
    var InetAddress = Java.type("java.net.InetAddress");
    var UUID = Java.type("java.util.UUID");
    var InputStreamReader = Java.type("java.io.InputStreamReader");
    var BufferedReader = Java.type("java.io.BufferedReader");
    var StandardCharsets = Java.type("java.nio.charset.StandardCharsets");
    var StringClass = Java.type("java.lang.String");
    var Thread = Java.type("java.lang.Thread");

    var CONFIG_DIR = new File(System.getProperty("user.home") + File.separator + ".easyea");
    var CONFIG_FILE = new File(CONFIG_DIR, "config.json");

    function loadConfig() {
        var config = { server_url: "http://localhost:8000", token: "", username: "", model_id: "", library_id: "", library_name: "", library_code: "" };
        if (CONFIG_FILE.exists()) {
            try {
                var scanner = new Scanner(CONFIG_FILE).useDelimiter("\\A");
                var content = scanner.hasNext() ? scanner.next() : "{}";
                scanner.close();
                var parsed = JSON.parse(content);
                if (parsed.server_url) config.server_url = parsed.server_url;
                if (parsed.token) config.token = parsed.token;
                if (parsed.username) config.username = parsed.username;
                if (parsed.model_id) config.model_id = parsed.model_id;
                if (parsed.library_id) config.library_id = parsed.library_id;
                if (parsed.library_name) config.library_name = parsed.library_name;
                if (parsed.library_code) config.library_code = parsed.library_code;
            } catch (e) {}
        }
        return config;
    }

    function escapeHtml(str) {
        if (!str) return "";
        return ("" + str)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    function saveConfig(config) {
        if (!CONFIG_DIR.exists()) {
            CONFIG_DIR.mkdirs();
            try {
                CONFIG_DIR.setReadable(false, false);
                CONFIG_DIR.setReadable(true, true);
                CONFIG_DIR.setWritable(true, true);
                CONFIG_DIR.setExecutable(true, true);
            } catch(e) {}
        }
        var writer = new FileWriter(CONFIG_FILE);
        writer.write(JSON.stringify(config, null, 2));
        writer.close();
        try {
            CONFIG_FILE.setReadable(false, false);
            CONFIG_FILE.setReadable(true, true); // owner-only permissions (0600)
            CONFIG_FILE.setWritable(true, true);
        } catch(e) {}
        ensureShutdownHookRegistered();
    }

    function ensureShutdownHookRegistered() {
        try {
            if ("true".equals(System.getProperty("easyea.shutdown.hook.registered"))) {
                return;
            }

            var PlatformUI = Java.type("org.eclipse.ui.PlatformUI");
            var IWorkbenchListener = Java.type("org.eclipse.ui.IWorkbenchListener");
            var MessageDialog = Java.type("org.eclipse.jface.dialogs.MessageDialog");
            var Display = Java.type("org.eclipse.swt.widgets.Display");
            var IEditorModelManager = Java.type("com.archimatetool.editor.model.IEditorModelManager");

            var workbench = PlatformUI.getWorkbench();
            if (!workbench) return;

            var listener = new IWorkbenchListener({
                preShutdown: function(wb, forced) {
                    try {
                        var userHome = System.getProperty("user.home");
                        var schemasDir = new File(userHome, ".easyea/checked_out");
                        if (!schemasDir.exists()) return true;

                        var configFile = new File(userHome, ".easyea/config.json");
                        var cfg = {};
                        if (configFile.exists()) {
                            try {
                                var sc = new Scanner(configFile).useDelimiter("\\A");
                                var cc = sc.hasNext() ? sc.next() : "{}";
                                sc.close();
                                cfg = JSON.parse(cc);
                            } catch(e) {}
                        }

                        var checkedOutSchemas = [];
                        var dirFiles = schemasDir.listFiles();
                        if (dirFiles) {
                            for (var i = 0; i < dirFiles.length; i++) {
                                var f = dirFiles[i];
                                if (f.getName().endsWith(".meta.json")) {
                                    try {
                                        var scanner = new Scanner(f).useDelimiter("\\A");
                                        var content = scanner.hasNext() ? scanner.next() : "{}";
                                        scanner.close();
                                        var p = JSON.parse(content);
                                        if (p.schema_id) {
                                            var archFileName = f.getName().substring(0, f.getName().length - ".meta.json".length);
                                            var archFile = new File(schemasDir, archFileName);
                                            checkedOutSchemas.push({
                                                schema_id: p.schema_id,
                                                model_id: p.model_id || "",
                                                library_name: p.library_name || "Active Library",
                                                schema_name: p.schema_name || "Schema",
                                                version: p.version || "v1.0",
                                                meta_file: f,
                                                archimate_file: archFile
                                            });
                                        }
                                    } catch(e) {}
                                }
                            }
                        }

                        if (checkedOutSchemas.length === 0) {
                            return true;
                        }

                        var shell = null;
                        try {
                            if (wb.getActiveWorkbenchWindow()) {
                                shell = wb.getActiveWorkbenchWindow().getShell();
                            }
                        } catch(e) {}
                        if (!shell) {
                            try {
                                var shells = Display.getDefault().getShells();
                                if (shells && shells.length > 0) shell = shells[0];
                            } catch(e2) {}
                        }

                        var schemaListMsg = "";
                        for (var s = 0; s < checkedOutSchemas.length; s++) {
                            schemaListMsg += " • " + checkedOutSchemas[s].schema_name + " [" + checkedOutSchemas[s].library_name + ", " + checkedOutSchemas[s].version + "]\n";
                        }

                        var dialogMsg = "You currently have " + checkedOutSchemas.length + " active schema checkout(s) with locked status on EasyEA:\n\n" +
                            schemaListMsg + "\n" +
                            "What would you like to do before closing Archi?";

                        var btnLabels = Java.to([
                            "Check-in All",
                            "Discard Checkout (Release Locks)",
                            "Keep Checkout & Exit",
                            "Cancel (Stay in Archi)"
                        ], "java.lang.String[]");

                        var dialog = new MessageDialog(
                            shell,
                            "EasyEA - Active Checkout Guard",
                            null,
                            dialogMsg,
                            MessageDialog.QUESTION,
                            btnLabels,
                            0
                        );

                        var choice = dialog.open();

                        if (choice === 3 || choice < 0) {
                            console.log("Archi shutdown cancelled by user to continue working on EasyEA models.");
                            return false;
                        }

                        if (choice === 2) {
                            console.log("Exiting Archi while keeping schema locks on EasyEA.");
                            return true;
                        }

                        var hClient = HttpClient.newBuilder()
                            .version(HttpClient.Version.HTTP_1_1)
                            .build();

                        if (choice === 0) {
                            for (var ci = 0; ci < checkedOutSchemas.length; ci++) {
                                var entry = checkedOutSchemas[ci];
                                try {
                                    var matchedOpenModel = null;
                                    try {
                                        var openModels = IEditorModelManager.INSTANCE.getModels();
                                        for (var omIdx = 0; omIdx < openModels.size(); omIdx++) {
                                            var om = openModels.get(omIdx);
                                            var rawOm = (typeof om.getEObject === "function") ? om.getEObject() : om;
                                            var fOm = (rawOm && typeof rawOm.getFile === "function") ? rawOm.getFile() : null;
                                            if (fOm && entry.archimate_file && fOm.getAbsolutePath() === entry.archimate_file.getAbsolutePath()) {
                                                matchedOpenModel = rawOm;
                                                try {
                                                    if (typeof rawOm.eResource === "function" && rawOm.eResource() !== null) {
                                                        rawOm.eResource().save(null);
                                                    }
                                                    IEditorModelManager.INSTANCE.saveModel(rawOm);
                                                } catch(smErr) {}
                                                break;
                                            }
                                        }
                                    } catch(omErr) {}

                                    if (entry.archimate_file && entry.archimate_file.exists()) {
                                        var xmlSc = new Scanner(entry.archimate_file).useDelimiter("\\A");
                                        var xmlContent = xmlSc.hasNext() ? xmlSc.next() : "";
                                        xmlSc.close();

                                        if (xmlContent.length > 0 && cfg.token && cfg.server_url) {
                                            var confirmPayload = JSON.stringify({
                                                file_content: xmlContent,
                                                xml_content: xmlContent,
                                                commit_message: "Auto check-in on Archi close",
                                                overwrite_attributes: true,
                                                remove_deleted_from_catalog: false
                                            });

                                            var req = HttpRequest.newBuilder()
                                                .uri(URI.create(cfg.server_url + "/api/schemas/" + entry.schema_id + "/checkin-confirm"))
                                                .version(HttpClient.Version.HTTP_1_1)
                                                .header("Authorization", "Bearer " + cfg.token)
                                                .header("Content-Type", "application/json")
                                                .POST(HttpRequest.BodyPublishers.ofString(confirmPayload))
                                                .build();

                                            var resp = hClient.send(req, HttpResponse.BodyHandlers.ofString());
                                            if (resp.statusCode() === 200) {
                                                try { entry.meta_file.delete(); } catch(e) {}
                                                try { entry.archimate_file.delete(); } catch(e2) {}
                                                if (matchedOpenModel) {
                                                    try { IEditorModelManager.INSTANCE.closeModel(matchedOpenModel); } catch(cmErr) {}
                                                }
                                                console.log("✓ Auto check-in completed for schema: " + entry.schema_name);
                                            } else {
                                                console.error("Auto check-in error HTTP " + resp.statusCode() + ": " + resp.body());
                                            }
                                        }
                                    }
                                } catch(chkErr) {
                                    console.log("Auto check-in error for " + entry.schema_name + ": " + chkErr);
                                }
                            }
                            return true;
                        }

                        if (choice === 1) {
                            for (var di = 0; di < checkedOutSchemas.length; di++) {
                                var discEntry = checkedOutSchemas[di];
                                try {
                                    var matchedDiscModel = null;
                                    try {
                                        var openModels2 = IEditorModelManager.INSTANCE.getModels();
                                        for (var omIdx2 = 0; omIdx2 < openModels2.size(); omIdx2++) {
                                            var om2 = openModels2.get(omIdx2);
                                            var rawOm2 = (typeof om2.getEObject === "function") ? om2.getEObject() : om2;
                                            var fOm2 = (rawOm2 && typeof rawOm2.getFile === "function") ? rawOm2.getFile() : null;
                                            if (fOm2 && discEntry.archimate_file && fOm2.getAbsolutePath() === discEntry.archimate_file.getAbsolutePath()) {
                                                matchedDiscModel = rawOm2;
                                                break;
                                            }
                                        }
                                    } catch(omErr2) {}

                                    if (cfg.token && cfg.server_url) {
                                        var discReq = HttpRequest.newBuilder()
                                            .uri(URI.create(cfg.server_url + "/api/schemas/" + discEntry.schema_id + "/discard-checkout"))
                                            .version(HttpClient.Version.HTTP_1_1)
                                            .header("Authorization", "Bearer " + cfg.token)
                                            .POST(HttpRequest.BodyPublishers.noBody())
                                            .build();

                                        var discResp = hClient.send(discReq, HttpResponse.BodyHandlers.ofString());
                                        if (discResp.statusCode() === 200) {
                                            try { discEntry.meta_file.delete(); } catch(e) {}
                                            try { discEntry.archimate_file.delete(); } catch(e2) {}
                                            if (matchedDiscModel) {
                                                try { IEditorModelManager.INSTANCE.closeModel(matchedDiscModel); } catch(cmErr2) {}
                                            }
                                            console.log("✓ Auto discard-checkout completed for schema: " + discEntry.schema_name);
                                        } else {
                                            console.error("Auto discard error HTTP " + discResp.statusCode() + ": " + discResp.body());
                                        }
                                    }
                                } catch(discErr) {
                                    console.log("Auto discard error for " + discEntry.schema_name + ": " + discErr);
                                }
                            }
                            return true;
                        }

                        return true;
                    } catch(hookErr) {
                        console.log("EasyEA Shutdown Guard error: " + hookErr);
                        return true;
                    }
                },
                postShutdown: function(wb) {}
            });

            workbench.addWorkbenchListener(listener);
            System.setProperty("easyea.shutdown.hook.registered", "true");
            console.log("✓ EasyEA Shutdown Guard listener registered.");
        } catch(regErr) {
            console.log("Note on registering shutdown guard listener: " + regErr);
        }
    }

    function openInBrowser(url) {
        var opened = false;
        try {
            var Desktop = Java.type("java.awt.Desktop");
            if (Desktop.isDesktopSupported() && Desktop.getDesktop().isSupported(Desktop.Action.BROWSE)) {
                Desktop.getDesktop().browse(new URI(url));
                opened = true;
            }
        } catch(e) {}

        if (!opened) {
            try {
                var Runtime = Java.type("java.lang.Runtime");
                Runtime.getRuntime().exec(["xdg-open", url]);
                opened = true;
            } catch(e2) {}
        }
        return opened;
    }

    function selectWorkingLibrary(targetServerUrl, authToken, currentModelId) {
        console.log("Fetching available libraries from EasyEA repository...");
        var reqModels = HttpRequest.newBuilder()
            .uri(URI.create(targetServerUrl + "/api/models"))
            .version(HttpClient.Version.HTTP_1_1)
            .header("Authorization", "Bearer " + authToken)
            .GET()
            .build();

        var respModels = client.send(reqModels, HttpResponse.BodyHandlers.ofString());
        if (respModels.statusCode() !== 200) {
            window.alert("Failed to retrieve libraries (HTTP " + respModels.statusCode() + "):\n" + respModels.body());
            return null;
        }

        var modelsList = JSON.parse(respModels.body()) || [];
        if (modelsList.length === 0) {
            window.alert("No library / workspace found on EasyEA repository.");
            return null;
        }

        if (modelsList.length === 1) {
            var singleLib = modelsList[0];
            console.log("Single library available: " + singleLib.name + " (" + (singleLib.code || singleLib.id) + ")");
            return singleLib;
        }

        var choices = [];
        var defaultIdx = 0;
        for (var i = 0; i < modelsList.length; i++) {
            var m = modelsList[i];
            var codeTag = m.code ? " [" + m.code + "]" : "";
            var elemInfo = (m.element_count !== undefined) ? " (" + m.element_count + " elements, " + (m.view_count || 0) + " views)" : "";
            choices.push((i + 1) + ". " + m.name + codeTag + elemInfo + " - ID: " + m.id);
            if (currentModelId && (m.id === currentModelId || (m.code && m.code === currentModelId))) {
                defaultIdx = i;
            }
        }

        var selectedChoice = null;
        if (typeof window.promptSelection === "function") {
            selectedChoice = window.promptSelection("Select the target Library for Archi operations:", choices);
        } else {
            var pMsg = "Select the target Library for Archi operations:\n\n" + choices.join("\n") + "\n\nEnter number (1 - " + choices.length + "):";
            var choiceNum = window.prompt(pMsg, "" + (defaultIdx + 1));
            if (choiceNum !== null) {
                var cIdx = parseInt(("" + choiceNum).trim(), 10) - 1;
                if (!isNaN(cIdx) && cIdx >= 0 && cIdx < choices.length) {
                    selectedChoice = choices[cIdx];
                }
            }
        }

        if (!selectedChoice) {
            console.log("Library selection cancelled.");
            return null;
        }

        for (var k = 0; k < choices.length; k++) {
            if (choices[k] === selectedChoice) {
                return modelsList[k];
            }
        }

        return modelsList[0];
    }

    try {
        var config = loadConfig();

        // 1. Prompt Server URL
        var serverUrl = window.prompt("Enter EasyEA Server URL:", config.server_url || "http://localhost:8000");
        if (serverUrl === null) {
            console.log("Operation cancelled by user.");
            return;
        }
        serverUrl = ("" + serverUrl).trim().replace(/\/+$/, "");
        if (!serverUrl) {
            window.alert("Server URL cannot be empty.");
            return;
        }

        // 2. Select Auth Method: IdP SSO vs Username/Password
        var options = [
            "1. Identity Provider SSO (Keycloak / Browser Flow)",
            "2. Local Username and Password"
        ];

        var selectedOption = null;
        if (typeof window.promptSelection === "function") {
            selectedOption = window.promptSelection("Select EasyEA authentication method:", options);
        } else {
            var promptMsg = "Select EasyEA authentication method:\n\n" +
                "1) Identity Provider SSO (Keycloak / Browser Flow)\n" +
                "2) Local Username and Password\n\n" +
                "Enter 1 or 2:";
            var choice = window.prompt(promptMsg, "1");
            if (choice === "1" || choice === "1.") selectedOption = options[0];
            else if (choice === "2" || choice === "2.") selectedOption = options[1];
        }

        if (!selectedOption) {
            console.log("Operation cancelled.");
            return;
        }

        var client = HttpClient.newBuilder()
            .version(HttpClient.Version.HTTP_1_1)
            .build();

        // -------------------------------------------------------------
        // OPTION 1: SSO with Identity Provider (Keycloak Loopback Flow)
        // -------------------------------------------------------------
        if (selectedOption.indexOf("1.") === 0) {
            console.log("Starting Single Sign-On (Keycloak) flow...");

            var serverSocket = null;
            var port = 8765;
            var loopback = InetAddress.getByName("127.0.0.1");
            for (var p = 8765; p <= 8775; p++) {
                try {
                    // SAST-MED-01: bind exclusively to 127.0.0.1 (not 0.0.0.0)
                    serverSocket = new ServerSocket(p, 1, loopback);
                    serverSocket.setSoTimeout(120000); // 2 min timeout
                    port = p;
                    break;
                } catch(portErr) {}
            }

            if (!serverSocket) {
                window.alert("Unable to open local port for authentication (ports 8765-8775 are busy).");
                return;
            }

            var expectedClientState = "archi_" + UUID.randomUUID().toString();
            var callbackUrl = "http://127.0.0.1:" + port + "/callback?client_state=" + expectedClientState;
            var authUrl = serverUrl + "/api/auth/oidc/login?return_to=" + encodeURIComponent(callbackUrl);

            console.log("Opening Keycloak login page in browser...");
            console.log("Authentication URL: " + authUrl);

            var browserOk = openInBrowser(authUrl);
            if (!browserOk) {
                window.alert("Open this URL in your browser to complete Keycloak login:\n\n" + authUrl);
            }

            console.log("Waiting for browser login completion (120s timeout)...");

            var receivedToken = null;
            var receivedError = null;
            var receivedClientState = null;
            var startTime = System.currentTimeMillis();

            while (!receivedToken && !receivedError && (System.currentTimeMillis() - startTime < 120000)) {
                var socket = null;
                try {
                    socket = serverSocket.accept();
                    var reader = new BufferedReader(new InputStreamReader(socket.getInputStream(), StandardCharsets.UTF_8));
                    var requestLine = reader.readLine();

                    if (requestLine) {
                        console.log("HTTP request received from browser: " + requestLine);

                        if (requestLine.indexOf("favicon.ico") !== -1) {
                            var outStream = socket.getOutputStream();
                            var resp204 = "HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n";
                            outStream.write(new StringClass(resp204).getBytes(StandardCharsets.UTF_8));
                            outStream.flush();
                            socket.close();
                            continue;
                        }

                        // Parse path & query params from "GET /path?token=... HTTP/1.1"
                        var lineParts = requestLine.split(" ");
                        var targetUri = lineParts.length > 1 ? lineParts[1] : "";
                        var qPos = targetUri.indexOf("?");
                        var queryStr = qPos !== -1 ? targetUri.substring(qPos + 1) : "";

                        var paramPairs = queryStr.split("&");
                        for (var pi = 0; pi < paramPairs.length; pi++) {
                            var eqIdx = paramPairs[pi].indexOf("=");
                            var paramKey = eqIdx !== -1 ? paramPairs[pi].substring(0, eqIdx) : paramPairs[pi];
                            var paramVal = eqIdx !== -1 ? paramPairs[pi].substring(eqIdx + 1) : "";
                            if (paramKey === "token" || paramKey === "auth_token" || paramKey === "access_token" || paramKey === "jwt") {
                                receivedToken = decodeURIComponent(paramVal);
                            } else if (paramKey === "error" || paramKey === "auth_error" || paramKey === "error_description") {
                                receivedError = decodeURIComponent(paramVal);
                            } else if (paramKey === "client_state") {
                                receivedClientState = decodeURIComponent(paramVal);
                            }
                        }

                        // SAST-MED-01: verify loopback anti-CSRF state token
                        if (receivedToken && receivedClientState !== expectedClientState) {
                            receivedError = "Invalid or missing anti-CSRF state token in loopback callback.";
                            receivedToken = null;
                        }

                        var htmlBody = "";
                        if (receivedToken) {
                            htmlBody = "<!DOCTYPE html><html><head><meta charset='utf-8'><title>EasyEA - Authentication Successful</title>" +
                                "<style>body{font-family:system-ui,-apple-system,sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;background:#0f172a;color:#f8fafc;}" +
                                ".card{background:#1e293b;padding:2.5rem;border-radius:1.25rem;box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);border:1px solid #334155;text-align:center;max-width:420px;}" +
                                "h1{color:#4ade80;font-size:1.5rem;margin:0 0 0.75rem 0;}p{color:#94a3b8;font-size:0.95rem;line-height:1.5;margin:0;}" +
                                ".badge{display:inline-block;margin-top:1.25rem;padding:0.4rem 1rem;background:#064e3b;color:#6ee7b7;border-radius:9999px;font-size:0.8rem;font-weight:bold;}</style></head>" +
                                "<body><div class='card'><h1>Authentication Successful!</h1><p>Your access token for Archi has been registered successfully.<br><br>You can now close this tab and return to <strong>Archi</strong> to select your working library.</p><div class='badge'>Active Keycloak Session</div></div></body></html>";
                        } else {
                            // SAST-MED-01: escape receivedError to prevent Reflected XSS
                            htmlBody = "<!DOCTYPE html><html><head><meta charset='utf-8'><title>EasyEA - Error</title>" +
                                "<style>body{font-family:system-ui,-apple-system,sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;background:#0f172a;color:#f8fafc;}" +
                                ".card{background:#1e293b;padding:2.5rem;border-radius:1.25rem;border:1px solid #ef4444;text-align:center;max-width:420px;}" +
                                "h1{color:#ef4444;font-size:1.5rem;margin:0 0 0.75rem 0;}p{color:#94a3b8;font-size:0.95rem;}</style></head>" +
                                "<body><div class='card'><h1>Authentication Error</h1><p>" + escapeHtml(receivedError || "Token parameter not found in the request.") + "</p></div></body></html>";
                        }

                        var bodyBytes = new StringClass(htmlBody).getBytes(StandardCharsets.UTF_8);
                        var httpHeaders = "HTTP/1.1 200 OK\r\n" +
                            "Content-Type: text/html; charset=UTF-8\r\n" +
                            "Content-Length: " + bodyBytes.length + "\r\n" +
                            "Connection: close\r\n\r\n";

                        var outStream = socket.getOutputStream();
                        outStream.write(new StringClass(httpHeaders).getBytes(StandardCharsets.UTF_8));
                        outStream.write(bodyBytes);
                        outStream.flush();
                        socket.close();

                        if (receivedToken || receivedError) {
                            break;
                        }
                    }
                } catch(sockEx) {
                    if (socket) try { socket.close(); } catch(se) {}
                    break;
                }
            }

            try {
                serverSocket.close();
            } catch(ssCloseErr) {}

            var receivedData = { token: receivedToken, error: receivedError };

            if (receivedData.token) {
                // Fetch profile with /api/auth/me
                var userDisplayName = "Keycloak User";
                try {
                    var reqMe = HttpRequest.newBuilder()
                        .uri(URI.create(serverUrl + "/api/auth/me"))
                        .version(HttpClient.Version.HTTP_1_1)
                        .header("Authorization", "Bearer " + receivedData.token)
                        .GET()
                        .build();

                    var respMe = client.send(reqMe, HttpResponse.BodyHandlers.ofString());
                    if (respMe.statusCode() === 200) {
                        var userData = JSON.parse(respMe.body());
                        if (userData.full_name) userDisplayName = userData.full_name;
                        else if (userData.username) userDisplayName = userData.username;
                    }
                } catch(meErr) {}

                // Select working Library
                var targetLib = selectWorkingLibrary(serverUrl, receivedData.token, config.model_id);
                if (!targetLib) {
                    window.alert("Authentication completed, but no library was selected. Default library configuration retained.");
                    targetLib = { id: config.model_id || "sample-easybank-ea", name: config.library_name || "Default Library", code: config.library_code || "" };
                }

                config.server_url = serverUrl;
                config.username = userDisplayName;
                config.token = receivedData.token;
                config.model_id = targetLib.id;
                config.library_id = targetLib.id;
                config.library_name = targetLib.name;
                config.library_code = targetLib.code || "";
                saveConfig(config);

                console.log("✓ Keycloak (IdP) authentication completed successfully!");
                console.log("✓ Connected user: " + userDisplayName);
                console.log("✓ Active Working Library: " + config.library_name + (config.library_code ? " [" + config.library_code + "]" : "") + " (" + config.model_id + ")");
                console.log("✓ Configuration saved in " + CONFIG_FILE.getAbsolutePath());

                window.alert(
                    "Keycloak (IdP) authentication & library selection completed!\n\n" +
                    "• User: " + userDisplayName + "\n" +
                    "• Server: " + serverUrl + "\n" +
                    "• Active Library: " + config.library_name + (config.library_code ? " [" + config.library_code + "]" : "") + "\n\n" +
                    "All operations (Check-out, Check-in, Discard, Repository Elements) are now scoped strictly to this library."
                );
            } else {
                var errMessage = receivedData.error || "Timeout: no token received from browser within 2 minutes.";
                console.error("IdP authentication failed: " + errMessage);
                window.alert("IdP authentication failed:\n" + errMessage);
            }

        // -------------------------------------------------------------
        // OPTION 2: Local Authentication with Username and Password
        // -------------------------------------------------------------
        } else {
            var username = window.prompt("Enter your EasyEA Username or Email:", config.username || "admin");
            if (username === null) {
                console.log("Operation cancelled by user.");
                return;
            }
            username = ("" + username).trim();
            if (!username) {
                window.alert("Username cannot be empty.");
                return;
            }

            var password = window.prompt("Enter password for '" + username + "':", "");
            if (password === null) {
                console.log("Operation cancelled by user.");
                return;
            }
            password = ("" + password).trim();

            console.log("Attempting connection to " + serverUrl + " as '" + username + "'...");

            var loginPayload = JSON.stringify({
                username: username,
                password: password
            });

            var req = HttpRequest.newBuilder()
                .uri(URI.create(serverUrl + "/api/auth/login"))
                .version(HttpClient.Version.HTTP_1_1)
                .header("Content-Type", "application/json")
                .POST(HttpRequest.BodyPublishers.ofString(loginPayload))
                .build();

            var resp = client.send(req, HttpResponse.BodyHandlers.ofString());

            if (resp.statusCode() === 200) {
                var loginData = JSON.parse(resp.body());
                var displayName = (loginData.user && loginData.user.full_name) ? loginData.user.full_name : username;

                // Select working Library
                var targetLib2 = selectWorkingLibrary(serverUrl, loginData.token, config.model_id);
                if (!targetLib2) {
                    window.alert("Authentication completed, but no library was selected. Default library configuration retained.");
                    targetLib2 = { id: config.model_id || "sample-easybank-ea", name: config.library_name || "Default Library", code: config.library_code || "" };
                }

                config.server_url = serverUrl;
                config.username = username;
                config.token = loginData.token;
                config.model_id = targetLib2.id;
                config.library_id = targetLib2.id;
                config.library_name = targetLib2.name;
                config.library_code = targetLib2.code || "";
                saveConfig(config);

                console.log("✓ Connected to EasyEA successfully! User: " + displayName);
                console.log("✓ Active Working Library: " + config.library_name + (config.library_code ? " [" + config.library_code + "]" : "") + " (" + config.model_id + ")");
                console.log("✓ Configuration saved in " + CONFIG_FILE.getAbsolutePath());

                window.alert(
                    "Connected to EasyEA successfully!\n\n" +
                    "• User: " + displayName + "\n" +
                    "• Server: " + serverUrl + "\n" +
                    "• Active Library: " + config.library_name + (config.library_code ? " [" + config.library_code + "]" : "") + "\n\n" +
                    "All operations (Check-out, Check-in, Discard, Repository Elements) are now scoped strictly to this library."
                );
            } else {
                var errText = "Login failed (HTTP " + resp.statusCode() + "):\n" + resp.body();
                console.error(errText);
                window.alert(errText);
            }
        }
    } catch (err) {
        var msg = "Error during script execution:\n" + err;
        console.error(msg);
        window.alert(msg);
    }
})();
