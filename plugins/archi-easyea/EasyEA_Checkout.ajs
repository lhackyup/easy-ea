/**
 * EasyEA Checkout Script for Archi (jArchi)
 * Connects to EasyEA, lists available schemas, performs check-out and opens the model directly in Archi.
 */

(function() {
    if (typeof console !== "undefined") {
        console.show();
        console.clear();
        console.log("== EasyEA Check-out ==");
    }

    var System = Java.type("java.lang.System");
    var File = Java.type("java.io.File");
    var FileWriter = Java.type("java.io.FileWriter");
    var Scanner = Java.type("java.util.Scanner");
    var URI = Java.type("java.net.URI");
    var HttpClient = Java.type("java.net.http.HttpClient");
    var HttpRequest = Java.type("java.net.http.HttpRequest");
    var HttpResponse = Java.type("java.net.http.HttpResponse");

    var IEditorModelManager = Java.type("com.archimatetool.editor.model.IEditorModelManager");

    var CONFIG_DIR = new File(System.getProperty("user.home") + File.separator + ".easyea");
    var CONFIG_FILE = new File(CONFIG_DIR, "config.json");
    var SCHEMAS_DIR = new File(CONFIG_DIR, "checked_out");

    function loadConfig() {
        var config = { server_url: "http://localhost:8000", token: "", username: "", model_id: "", library_id: "", library_name: "", library_code: "" };
        if (CONFIG_FILE.exists()) {
            try {
                var scanner = new Scanner(CONFIG_FILE).useDelimiter("\\A");
                var content = scanner.hasNext() ? scanner.next() : "{}";
                scanner.close();
                var parsed = JSON.parse(content);
                if (parsed.server_url) config.server_url = parsed.server_url;
                if (parsed.token) config.token = parsed.token;
                if (parsed.username) config.username = parsed.username;
                if (parsed.model_id) config.model_id = parsed.model_id;
                if (parsed.library_id) config.library_id = parsed.library_id;
                if (parsed.library_name) config.library_name = parsed.library_name;
                if (parsed.library_code) config.library_code = parsed.library_code;
            } catch (e) {}
        }
        return config;
    }

    try {
        var config = loadConfig();
        if (!config.token) {
            window.alert("Please configure your credentials first by running 'EasyEA_Settings.ajs'.");
            return;
        }

        var client = HttpClient.newBuilder()
            .version(HttpClient.Version.HTTP_1_1)
            .build();

        // 1. Verify / Resolve Active Library
        var activeModelId = config.model_id || config.library_id;
        var activeLibraryName = config.library_name || "Enterprise Architecture Library";
        var activeLibraryCode = config.library_code || "";

        if (!activeModelId) {
            // Fetch available models from server
            var reqModels = HttpRequest.newBuilder()
                .uri(URI.create(config.server_url + "/api/models"))
                .version(HttpClient.Version.HTTP_1_1)
                .header("Authorization", "Bearer " + config.token)
                .GET()
                .build();

            var respModels = client.send(reqModels, HttpResponse.BodyHandlers.ofString());
            if (respModels.statusCode() !== 200) {
                window.alert("Session expired or server unreachable (HTTP " + respModels.statusCode() + "). Please run 'EasyEA_Settings.ajs' again.");
                return;
            }

            var modelsList = JSON.parse(respModels.body()) || [];
            if (modelsList.length === 0) {
                window.alert("No library / workspace found on EasyEA.");
                return;
            }

            if (modelsList.length === 1) {
                activeModelId = modelsList[0].id;
                activeLibraryName = modelsList[0].name;
                activeLibraryCode = modelsList[0].code || "";
            } else {
                var libChoices = [];
                for (var li = 0; li < modelsList.length; li++) {
                    var lm = modelsList[li];
                    var lcode = lm.code ? " [" + lm.code + "]" : "";
                    libChoices.push((li + 1) + ". " + lm.name + lcode + " - ID: " + lm.id);
                }
                var selLibChoice = null;
                if (typeof window.promptSelection === "function") {
                    selLibChoice = window.promptSelection("Select the target Library for Check-out:", libChoices);
                } else {
                    var lPrompt = "Select target Library for Check-out:\n\n" + libChoices.join("\n") + "\n\nEnter number:";
                    var lNum = window.prompt(lPrompt, "1");
                    if (lNum !== null) {
                        var lIdx = parseInt(("" + lNum).trim(), 10) - 1;
                        if (!isNaN(lIdx) && lIdx >= 0 && lIdx < modelsList.length) selLibChoice = libChoices[lIdx];
                    }
                }
                if (!selLibChoice) {
                    console.log("Check-out cancelled.");
                    return;
                }
                for (var lk = 0; lk < libChoices.length; lk++) {
                    if (libChoices[lk] === selLibChoice) {
                        activeModelId = modelsList[lk].id;
                        activeLibraryName = modelsList[lk].name;
                        activeLibraryCode = modelsList[lk].code || "";
                        break;
                    }
                }
            }

            config.model_id = activeModelId;
            config.library_id = activeModelId;
            config.library_name = activeLibraryName;
            config.library_code = activeLibraryCode;
            try {
                var fw = new FileWriter(CONFIG_FILE);
                fw.write(JSON.stringify(config, null, 2));
                fw.close();
            } catch(ce) {}
        }

        console.log("Target Library: " + activeLibraryName + (activeLibraryCode ? " [" + activeLibraryCode + "]" : "") + " (" + activeModelId + ")");

        // 2. Fetch schemas for active library
        var reqSchemas = HttpRequest.newBuilder()
            .uri(URI.create(config.server_url + "/api/schemas/" + encodeURIComponent(activeModelId) + "/list"))
            .version(HttpClient.Version.HTTP_1_1)
            .header("Authorization", "Bearer " + config.token)
            .GET()
            .build();

        var respSchemas = client.send(reqSchemas, HttpResponse.BodyHandlers.ofString());
        if (respSchemas.statusCode() !== 200) {
            window.alert("Failed to retrieve schemas for library '" + activeLibraryName + "' (HTTP " + respSchemas.statusCode() + "):\n" + respSchemas.body());
            return;
        }

        var schemasList = JSON.parse(respSchemas.body()) || [];
        if (schemasList.length === 0) {
            window.alert("No schemas available in EasyEA repository for library '" + activeLibraryName + "'.");
            return;
        }

        // 3. Selection list
        var schemaLabels = [];
        for (var i = 0; i < schemasList.length; i++) {
            var s = schemasList[i];
            var statusStr = (s.status === "checked_out")
                ? " [🔒 CHECKED OUT by " + (s.locked_by_username || "Architect") + "]"
                : " [🟢 AVAILABLE]";
            schemaLabels.push((i + 1) + ". " + s.name + " (" + s.current_version + ")" + statusStr);
        }

        var selectedLabel = null;
        if (typeof window.promptSelection === "function") {
            selectedLabel = window.promptSelection("Select the EasyEA schema to download and lock:", schemaLabels);
        } else {
            var promptMsg = "Select the EasyEA schema to download and lock:\n\n" + schemaLabels.join("\n") + "\n\nEnter number (1 - " + schemasList.length + "):";
            var choice = window.prompt(promptMsg, "1");
            if (choice !== null) {
                var idx = parseInt(("" + choice).trim(), 10) - 1;
                if (!isNaN(idx) && idx >= 0 && idx < schemasList.length) {
                    selectedLabel = schemaLabels[idx];
                }
            }
        }

        if (!selectedLabel) {
            console.log("Check-out cancelled.");
            return;
        }

        var selectedIndex = 0;
        for (var k = 0; k < schemaLabels.length; k++) {
            if (schemaLabels[k] === selectedLabel) {
                selectedIndex = k;
                break;
            }
        }

        var selectedSchema = schemasList[selectedIndex];
        console.log("Requesting lock (check-out) for: " + selectedSchema.name + " (ID: " + selectedSchema.id + ")...");

        // 4. Perform checkout on EasyEA
        var reqCheckout = HttpRequest.newBuilder()
            .uri(URI.create(config.server_url + "/api/schemas/" + selectedSchema.id + "/checkout"))
            .version(HttpClient.Version.HTTP_1_1)
            .header("Authorization", "Bearer " + config.token)
            .POST(HttpRequest.BodyPublishers.noBody())
            .build();

        var respCheckout = client.send(reqCheckout, HttpResponse.BodyHandlers.ofString());
        if (respCheckout.statusCode() !== 200) {
            var errDetail = respCheckout.body();
            try {
                var errObj = JSON.parse(errDetail);
                if (errObj.detail) errDetail = errObj.detail;
            } catch(ex) {}
            window.alert("Unable to lock schema:\n" + errDetail);
            return;
        }

        // 5. Download .archimate XML
        console.log("Downloading schema XML file...");
        var reqDownload = HttpRequest.newBuilder()
            .uri(URI.create(config.server_url + "/api/schemas/" + selectedSchema.id + "/download"))
            .version(HttpClient.Version.HTTP_1_1)
            .header("Authorization", "Bearer " + config.token)
            .GET()
            .build();

        var respDownload = client.send(reqDownload, HttpResponse.BodyHandlers.ofString());
        if (respDownload.statusCode() !== 200) {
            window.alert("Error downloading schema file from EasyEA.");
            return;
        }

        var xmlContent = respDownload.body();

        // 6. Save locally
        if (!SCHEMAS_DIR.exists()) {
            SCHEMAS_DIR.mkdirs();
        }

        var cleanName = selectedSchema.name.replace(/[^a-zA-Z0-9_\-\.]/g, "_");
        var localFile = new File(SCHEMAS_DIR, selectedSchema.id + "_" + cleanName + ".archimate");

        var writer = new FileWriter(localFile);
        writer.write(xmlContent);
        writer.close();

        // Save metadata
        var metaFile = new File(SCHEMAS_DIR, localFile.getName() + ".meta.json");
        var metaWriter = new FileWriter(metaFile);
        metaWriter.write(JSON.stringify({
            schema_id: selectedSchema.id,
            model_id: activeModelId,
            library_name: activeLibraryName,
            library_code: activeLibraryCode,
            schema_name: selectedSchema.name,
            version: selectedSchema.current_version,
            checked_out_at: new Date().toISOString()
        }, null, 2));
        metaWriter.close();

        console.log("✓ Schema file saved: " + localFile.getAbsolutePath());
        console.log("Opening schema in Archi...");

        // 7. Open model in Archi
        var loadedModel = IEditorModelManager.INSTANCE.openModel(localFile);

        try {
            if (typeof $ !== "undefined" && loadedModel) {
                $(loadedModel).prop("EasyEA_Schema_ID", selectedSchema.id);
                $(loadedModel).prop("EasyEA_Model_ID", activeModelId);
                $(loadedModel).prop("EasyEA_Library_Name", activeLibraryName);
                $(loadedModel).prop("EasyEA_Library_Code", activeLibraryCode);
                $(loadedModel).prop("EasyEA_Schema_Name", selectedSchema.name);
            }
        } catch(propErr) {}

        window.alert(
            "Schema '" + selectedSchema.name + "' has been locked successfully and opened in Archi!\n\n" +
            "• Active Library: " + activeLibraryName + (activeLibraryCode ? " [" + activeLibraryCode + "]" : "") + "\n" +
            "• Version: " + selectedSchema.current_version + "\n\n" +
            "You can now edit it in the designer. When finished, run 'EasyEA_Checkin.ajs' to commit changes to EasyEA."
        );

    } catch (e) {
        var errStr = "Error during check-out:\n" + e;
        console.error(errStr);
        window.alert(errStr);
    }
})();
