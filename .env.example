# EasyEA Environment Configuration Example
# Copy this file to .env and set strong values before running docker-compose.

EASYEA_ENV=production
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
EASYEA_SECRET_KEY=replace-with-a-cryptographically-random-secret-at-least-32-chars
EASYEA_SEED_DEMO_USERS=false
EASYEA_ADMIN_PASSWORD=replace-with-strong-initial-admin-password

POSTGRES_USER=easyea_user
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_DB=easyea_db

OIDC_ENABLED=true
OIDC_ISSUER_URL=http://host.docker.internal:18000/realms/dev-realm
OIDC_CLIENT_ID=easyea-client
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
OIDC_FRONTEND_REDIRECT_URL=http://localhost:8000
EASYEA_RBAC_MODE=hybrid
